// Data model for the Remedium Sales Dashboard. See SPEC.md, "Data model".
//
// Conventions
// - Money is numeric(14,2) and quantities numeric(12,2), never floating point.
// - Table and column names are snake_case in Postgres; Prisma fields are camelCase.
// - The sales_lines view, the one-running-sync lock and CHECK constraints are
//   written in SQL in the migrations, because Prisma's schema can't express them.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// QuickBooks data (written only by the sync job)
// ---------------------------------------------------------------------------

enum DocType {
  invoice
  credit_memo

  @@map("doc_type")
}

/// One row per QuickBooks Invoice or CreditMemo. QuickBooks ids are only
/// guaranteed unique within one entity type, so the key is (doc_type, qbo_id).
model Invoice {
  docType        DocType  @map("doc_type")
  qboId          String   @map("qbo_id")
  docNumber      String?  @map("doc_number")
  txnDate        DateTime @map("txn_date") @db.Date
  customerQboId  String   @map("customer_qbo_id")
  /// CustomerRef.name at sync time; used only if the customer row is missing.
  customerName   String?  @map("customer_name")
  totalAmt       Decimal  @map("total_amt") @db.Decimal(14, 2)
  balance        Decimal  @db.Decimal(14, 2)
  lastUpdatedQbo DateTime @map("last_updated_qbo") @db.Timestamptz(3)
  deleted        Boolean  @default(false)
  syncedAt       DateTime @default(now()) @map("synced_at") @db.Timestamptz(3)

  lines InvoiceLine[]

  @@id([docType, qboId])
  @@index([txnDate])
  @@index([customerQboId])
  @@map("invoices")
}

/// Only SalesItemLineDetail lines. An edited invoice has all of its lines
/// replaced, so quantities never double count.
model InvoiceLine {
  id           BigInt  @id @default(autoincrement())
  docType      DocType @map("doc_type")
  invoiceQboId String  @map("invoice_qbo_id")
  lineNum      Int     @map("line_num")
  itemQboId    String? @map("item_qbo_id")
  /// ItemRef.name at sync time; used only if the item row is missing.
  itemName     String? @map("item_name")
  qty          Decimal @db.Decimal(12, 2)
  /// Four decimals because QuickBooks unit prices can carry more than cents.
  /// Not summed anywhere; Sales $ always comes from amount.
  unitPrice    Decimal @map("unit_price") @db.Decimal(14, 4)
  amount       Decimal @db.Decimal(14, 2)
  description  String?

  invoice Invoice @relation(fields: [docType, invoiceQboId], references: [docType, qboId], onDelete: Cascade)

  @@unique([docType, invoiceQboId, lineNum])
  @@index([invoiceQboId])
  @@index([itemQboId])
  @@map("invoice_lines")
}

model Item {
  qboId               String   @id @map("qbo_id")
  fullName            String   @map("full_name")
  /// Last segment of full_name.
  sku                 String
  /// Everything before the SKU, joined with " › ". Null when there is none.
  category            String?
  /// SKU with any "-AMZ" / " - AMZ" suffix and "-3PK"-style pack code removed.
  baseSku             String   @map("base_sku")
  isPackVariant       Boolean  @default(false) @map("is_pack_variant")
  /// False for the named non-product items (profit share services, shipping, R&D, discount); the admin can override it.
  isProduct           Boolean  @default(true) @map("is_product")
  /// True once the admin has set is_product by hand; the sync then leaves it alone.
  isProductSetByAdmin Boolean  @default(false) @map("is_product_set_by_admin")
  /// QuickBooks item type (Inventory, NonInventory, Service, ...).
  itemType            String?  @map("item_type")
  /// QuickBooks PurchaseCost per unit (case), for inventory value. Null when QuickBooks has none.
  purchaseCost        Decimal? @map("purchase_cost") @db.Decimal(14, 4)
  active              Boolean  @default(true)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([sku])
  @@index([baseSku])
  @@map("items")
}

model Customer {
  qboId       String   @id @map("qbo_id")
  displayName String   @map("display_name")
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("customers")
}

// ---------------------------------------------------------------------------
// Owner-maintained reference data
// ---------------------------------------------------------------------------

/// Eaches per QuickBooks unit, keyed by the item's own SKU (so
/// "REMSF99B - AMZ" has its own row even though it reports under REMSF99B).
model SkuConversion {
  sku           String   @id
  eachesPerUnit Int      @map("eaches_per_unit")
  /// Free-text note, e.g. "please fill in" for values the owner hasn't confirmed.
  note          String?
  updatedBy     String   @map("updated_by")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("sku_conversions")
}

/// Monthly usage the owner provides per SKU (in QuickBooks units, usually
/// cases). Months of supply uses the greater of this and the last 3 full
/// months' average sales.
model SkuUsage {
  sku          String   @id
  monthlyUnits Decimal  @map("monthly_units") @db.Decimal(12, 2)
  updatedBy    String   @map("updated_by")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("sku_usage")
}

// ---------------------------------------------------------------------------
// Inventory, from QuickBooks quantity on hand
// ---------------------------------------------------------------------------

/// Stock for one SKU as QuickBooks last reported it, in QuickBooks units
/// (cases). The whole table is replaced on every inventory sync.
model InventoryLevel {
  sku              String    @id
  itemQboId        String    @map("item_qbo_id")
  name             String?
  /// QtyOnHand minus QtyOnSalesOrder: what can be sold now.
  qtyAvailable     Decimal   @map("qty_available") @db.Decimal(14, 2)
  /// QtyOnSalesOrder: on hand but committed to open sales orders.
  qtyReserved      Decimal   @map("qty_reserved") @db.Decimal(14, 2)
  /// Not tracked in QuickBooks; always 0.
  qtyHeld          Decimal   @map("qty_held") @db.Decimal(14, 2)
  /// Still to receive on open QuickBooks purchase orders (open_po_lines).
  qtyIncoming      Decimal   @map("qty_incoming") @db.Decimal(14, 2)
  /// Not tracked in QuickBooks; always 0.
  qtyBackordered   Decimal   @map("qty_backordered") @db.Decimal(14, 2)
  /// QuickBooks ReorderPoint, kept for reference.
  minQtyOnHand     Decimal?  @map("min_qty_on_hand") @db.Decimal(14, 2)
  sourceUpdatedAt  DateTime? @map("source_updated_at") @db.Timestamptz(3)
  syncedAt         DateTime  @map("synced_at") @db.Timestamptz(3)

  @@map("inventory_levels")
}

/// Lines of open QuickBooks purchase orders still to be received, replaced on
/// every inventory sync. Quantities are in QuickBooks units (cases).
model OpenPoLine {
  poQboId      String    @map("po_qbo_id")
  lineId       String    @map("line_id")
  sku          String
  itemQboId    String    @map("item_qbo_id")
  docNumber    String?   @map("doc_number")
  vendor       String?
  txnDate      DateTime  @map("txn_date") @db.Date
  /// The PO's due date (or ship date), when it has one.
  expectedDate DateTime? @map("expected_date") @db.Date
  qtyOrdered   Decimal   @map("qty_ordered") @db.Decimal(14, 2)
  qtyRemaining Decimal   @map("qty_remaining") @db.Decimal(14, 2)
  /// The PO line's dollar amount, and cost per unit, when QuickBooks has them.
  amount       Decimal?  @db.Decimal(14, 2)
  unitPrice    Decimal?  @map("unit_price") @db.Decimal(14, 4)
  syncedAt     DateTime  @map("synced_at") @db.Timestamptz(3)

  @@id([poQboId, lineId])
  @@index([sku])
  @@map("open_po_lines")
}

/// One row per inventory sync. A partial unique index (in the migration)
/// allows one running row at a time.
model InventorySyncRun {
  id          BigInt     @id @default(autoincrement())
  status      SyncStatus @default(running)
  triggeredBy String     @map("triggered_by")
  startedAt   DateTime   @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt  DateTime?  @map("finished_at") @db.Timestamptz(3)
  /// Stock-tracked SKUs stored in this run.
  skus        Int        @default(0)
  apiRequests Int        @default(0) @map("api_requests")
  note        String?
  error       String?

  @@index([startedAt])
  @@map("inventory_sync_runs")
}

// ---------------------------------------------------------------------------
// Sync bookkeeping
// ---------------------------------------------------------------------------

enum SyncKind {
  full
  incremental

  @@map("sync_kind")
}

enum SyncStatus {
  running
  succeeded
  failed

  @@map("sync_status")
}

/// One row per sync run. A partial unique index (in the migration) allows at
/// most one row with status = 'running', which is the sync lock.
model SyncRun {
  id                BigInt     @id @default(autoincrement())
  kind              SyncKind
  status            SyncStatus @default(running)
  /// "cron", or the email of the admin who pressed Refresh now.
  triggeredBy       String     @map("triggered_by")
  startedAt         DateTime   @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt        DateTime?  @map("finished_at") @db.Timestamptz(3)
  /// Invoices plus credit memos written in this run.
  invoicesUpserted  Int        @default(0) @map("invoices_upserted")
  invoicesDeleted   Int        @default(0) @map("invoices_deleted")
  itemsUpserted     Int        @default(0) @map("items_upserted")
  customersUpserted Int        @default(0) @map("customers_upserted")
  /// QuickBooks API requests made, including retries.
  apiRequests       Int        @default(0) @map("api_requests")
  /// How the run went, e.g. "CDC since …" or "full re-read: CDC failed (…)".
  note              String?
  error             String?
  /// True once the failure alert email for this run has been handled.
  alerted           Boolean    @default(false)

  @@index([startedAt])
  @@map("sync_runs")
}

// ---------------------------------------------------------------------------
// Server-only tables
// ---------------------------------------------------------------------------

enum Role {
  admin
  viewer

  @@map("role")
}

/// Who may sign in. Emails are stored lowercase (enforced by a CHECK).
model AllowedUser {
  email     String   @id
  role      Role     @default(viewer)
  addedBy   String   @map("added_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("allowed_users")
}

/// The single company-level QuickBooks connection (id is always 1).
/// Tokens are AES-256-GCM ciphertext; they are never sent to the browser.
model QboConnection {
  id                    Int       @id @default(1)
  realmId               String    @map("realm_id")
  /// "sandbox" or "production": a connection only works with the matching keys.
  environment           String
  /// CompanyInfo.CompanyName at connect time, shown on the admin page.
  companyName           String?   @map("company_name")
  accessTokenEnc        String    @map("access_token_enc")
  refreshTokenEnc       String    @map("refresh_token_enc")
  accessTokenExpiresAt  DateTime  @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime  @map("refresh_token_expires_at") @db.Timestamptz(3)
  /// Last successful token refresh, and the last refresh failure (cleared on success).
  lastRefreshedAt       DateTime? @map("last_refreshed_at") @db.Timestamptz(3)
  lastRefreshError      String?   @map("last_refresh_error")
  connectedBy           String    @map("connected_by")
  connectedAt           DateTime  @default(now()) @map("connected_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("qbo_connection")
}

/// Sign-ins, syncs and allow-list changes, kept for 90 days.
model AuditLog {
  id     BigInt   @id @default(autoincrement())
  at     DateTime @default(now()) @db.Timestamptz(3)
  /// Email of the person, or "cron" / "system".
  actor  String
  /// e.g. "sign_in", "sign_in_denied", "sync_started", "allowed_user_added".
  action String
  detail Json?

  @@index([at])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Auth.js tables (names and fields as @auth/prisma-adapter expects)
//
// Sessions are JWT cookies, so the sessions table stays empty; it exists
// because the adapter's interface includes it. Microsoft's OAuth tokens are
// stripped before an account is saved (see lib/auth.ts), so the token columns
// stay empty too. Roles are NOT stored here: every request looks the email
// up in allowed_users, so removing someone takes effect immediately.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified") @db.Timestamptz(3)
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  accounts Account[]
  sessions Session[]

  @@map("users")
}

model Account {
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz(3)

  @@id([identifier, token])
  @@map("verification_tokens")
}
