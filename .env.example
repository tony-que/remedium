# Copy this file to .env and fill in the values. Never commit .env.
# Names only here; real values live in your host's secret store (Vercel env vars).

# Postgres connection string (local dev, Neon or Supabase)
DATABASE_URL=

# QuickBooks Online app (developer.intuit.com), server-side only
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=
# "sandbox" or "production"
QBO_ENVIRONMENT=

# 32-byte key, base64, for AES-256-GCM encryption of QuickBooks tokens
# Generate with: openssl rand -base64 32
TOKEN_ENC_KEY=

# Auth.js session secret. Generate with: openssl rand -base64 32
AUTH_SECRET=
# The app's public URL, e.g. https://sales.example.com (http://localhost:3000 locally)
AUTH_URL=

# First admin, added to the allow-list by `npm run db:seed`
ADMIN_EMAIL=

# Microsoft Entra ID single sign-on (app registration client id and secret)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Comma-separated tenant ids (GUIDs) whose accounts may sign in.
# Look one up: https://login.microsoftonline.com/<domain>/v2.0/.well-known/openid-configuration
#   remedium-usa.com     929e6f0f-0091-439a-a7e7-8d4e530b64d7
#   stairwayventures.com 5500e785-513f-4ff9-b917-93a0c7e1a840
AUTH_MICROSOFT_ENTRA_ID_ALLOWED_TENANTS=

# Email magic-link fallback and admin alerts, sent through Resend (resend.com)
AUTH_RESEND_KEY=
# Sender, on a domain verified in Resend, e.g. "Remedium Cockpit <sales@example.com>"
EMAIL_FROM=

# Local development only: shows a "Dev login" form under `next dev`.
# Ignored by production builds.
AUTH_DEV_LOGIN=

# Shared secret that protects the /api/sync cron route (at least 16 characters).
# Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
# Generate with: openssl rand -hex 24
CRON_SECRET=

# First date the sync loads (default 2024-01-01)
SYNC_START_DATE=

# Separate database for `npm test`; migrations are applied to it automatically.
# Tests write only inside transactions that roll back.
TEST_DATABASE_URL=

# Separate database for `npm run test:e2e`, reset and seeded with fake data on each run.
E2E_DATABASE_URL=

