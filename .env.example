# Copy this file to .env and fill in the values. Never commit .env.
# Names only here; real values live in your host's secret store (Vercel env vars).

# Postgres connection string (local dev, Neon or Supabase)
DATABASE_URL=

# QuickBooks Online app (developer.intuit.com), server-side only
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=
# "sandbox" or "production"
QBO_ENVIRONMENT=

# 32-byte key, base64, for AES-256-GCM encryption of QuickBooks tokens
# Generate with: openssl rand -base64 32
TOKEN_ENC_KEY=

# Auth.js session secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Microsoft Entra ID single sign-on (company tenant only)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Shared secret that protects the /api/sync cron route
CRON_SECRET=

# Separate database for `npm test`; migrations are applied to it automatically.
# Tests write only inside transactions that roll back.
TEST_DATABASE_URL=
